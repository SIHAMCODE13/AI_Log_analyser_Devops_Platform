# =====================================================
# AI DevOps Log Analyzer — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =====================================================

# Backend
DATABASE_URL=mysql+aiomysql://loguser:logpass@mysql:3306/loganalyzer
AI_SERVICE_URL=http://ai-service:8001
SECRET_KEY=change-me-to-a-strong-random-secret
DEBUG=false
CORS_ORIGINS=["http://localhost","http://localhost:80"]
MAX_FILE_SIZE_MB=100

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=loganalyzer
MYSQL_USER=loguser
MYSQL_PASSWORD=logpass

# Grafana
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana
