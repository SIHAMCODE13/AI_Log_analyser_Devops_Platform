{
  "title": "AI Log Analyzer — Platform Overview",
  "uid": "loganalyzer-main",
  "version": 5,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total HTTP Requests",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(http_request_duration_seconds_count)", "legendFormat": "Requests" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2, "type": "stat", "title": "Request Rate (req/s)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_count[5m]))", "legendFormat": "Req/s" }],
      "options": { "colorMode": "value" }
    },
    {
      "id": 3, "type": "stat", "title": "AI Predictions Total",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(ai_predictions_total) or vector(0)", "legendFormat": "Predictions" }]
    },
    {
      "id": 4, "type": "stat", "title": "Avg Prediction Latency",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "rate(ai_prediction_duration_seconds_sum[5m]) / rate(ai_prediction_duration_seconds_count[5m])", "legendFormat": "Latency" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Request Rate by Endpoint",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum by (endpoint) (rate(http_request_duration_seconds_count[5m]))", "legendFormat": "{{endpoint}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Request Latency p95",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
